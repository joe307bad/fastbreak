platform :ios do
  desc "Capture App Store screenshots in the simulator"
  lane :screenshots do
    capture_ios_screenshots
    UI.success("Screenshots written to fastlane/screenshots")
  end

  desc "Capture App Store screenshots and upload them to App Store Connect"
  lane :screenshots_upload do
    # CI passes an App Store Connect API key; a laptop usually has only the
    # Apple ID session fastlane stores after its first interactive sign-in.
    # Take the key when it is there and fall back to the session when it is
    # not, rather than making the key a hard requirement for a local run.
    api_key = nil
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] &&
       ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] &&
       ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      )
      UI.message("Authenticating with the App Store Connect API key")
    else
      UI.message("No API key in the environment; using the stored Apple ID session")
    end

    capture_ios_screenshots

    # Screenshots only: no binary, no metadata, and nothing submitted for
    # review. The shots land on the current editable App Store version for
    # someone to look at before they go anywhere.
    options = {
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      force: true
    }
    options[:api_key] = api_key if api_key

    upload_to_app_store(options)
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: true
    )

    # Create a temporary keychain for CI
    keychain_name = "fastlane_tmp_keychain"
    keychain_password = SecureRandom.base64

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    # Use VERSION_NAME from CI environment (centralized in gradle.properties)
    if ENV["VERSION_NAME"]
      increment_version_number(
        version_number: ENV["VERSION_NAME"],
        xcodeproj: "iosApp.xcodeproj"
      )
    end

    # Use BUILD_NUMBER from CI environment (github.run_number)
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"],
      xcodeproj: "iosApp.xcodeproj"
    )

    build_app(
      workspace: "iosApp.xcworkspace",
      scheme: "Fastbreak",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='match AppStore com.joebad.fastbreak' CODE_SIGN_IDENTITY='iPhone Distribution'",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.joebad.fastbreak" => "match AppStore com.joebad.fastbreak"
        }
      }
    )

    upload_to_testflight(api_key: api_key)

    # Upload dSYMs to Sentry for crash symbolication
    if ENV["SENTRY_AUTH_TOKEN"]
      sentry_upload_dif(
        auth_token: ENV["SENTRY_AUTH_TOKEN"],
        org_slug: "joe-badaczewski",
        project_slug: "fastbreak-ios",
        include_sources: true
      )
    end

    delete_keychain(name: keychain_name)
  end
end