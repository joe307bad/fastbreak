# Run daily scripts every day at 9am Eastern Time.
# Not earlier: the ESPN box scores these scripts read come from the
# sportsdataverse-data releases, whose first refresh of the day lands around
# 7:30am ET. A 6am run saw yesterday's board and reported stale records.
# Every job goes through run-script.sh, which records status/timing to DynamoDB (scheduler-o11y)
0 9 * * * . /app/env.sh && /usr/bin/find /app/daily -name "*.R" -exec /app/run-script.sh daily {} \; >> /var/log/cron.log 2>&1

# Run Fastbreak.Daily v2 (generate + enrich + upload to S3 + update DynamoDB) every day at 9am Eastern Time
# v1 is disabled — the v2 pipeline writes to the same S3 key so it replaces v1's output.
# 0 9 * * * . /app/env.sh && /app/Fastbreak.Daily >> /var/log/cron.log 2>&1
0 9 * * * . /app/env.sh && /app/run-script.sh topics /app/Fastbreak.Daily generate-and-enrich-topics >> /var/log/cron.log 2>&1

# Run weekly scripts every Sunday at 10am Eastern Time
0 10 * * 0 . /app/env.sh && /usr/bin/find /app/weekly -name "*.R" -exec /app/run-script.sh weekly {} \; >> /var/log/cron.log 2>&1

